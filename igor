#!/bin/bash
# igor - local PHP sites (Laravel, Symfony, WordPress, ...) on macOS with the
# ValueQuest FrankenPHP suite.
#
#   Browser  -> https://<name>.test  (front proxy, Caddy local CA, ports 80/443)
#            -> http://127.0.0.1:<port>  (one FrankenPHP server per site, HTTPS=on)
#   App-to-app calls go straight to http://127.0.0.1:<port>, no TLS.
#
# PHP runtimes are shared: ~/frankenphp/php8.x/bin (suite, --versioned install).
# Each project pins its version in .php-version; direnv puts that bin/ on PATH.
#
# Written for the bash 3.2 that ships with macOS.

set -euo pipefail

IGOR_HOME="${IGOR_HOME:-$HOME/.igor}"
IGOR_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"   # for watchers
PHP_ROOT="${IGOR_PHP_ROOT:-$HOME/frankenphp}"
TLD="${IGOR_TLD:-test}"
FIRST_PORT=8101
LABEL_PREFIX="dev.igor"
AGENTS="$HOME/Library/LaunchAgents"
REGISTRY="$IGOR_HOME/sites.tsv"      # name <TAB> port <TAB> type <TAB> php <TAB> dir [<TAB> docroot]
CADDYFILE="$IGOR_HOME/Caddyfile"
SITES_DIR="$IGOR_HOME/sites"          # front proxy routes (imported by the proxy)
BACKENDS_DIR="$IGOR_HOME/backends"    # one FrankenPHP Caddyfile per site
SHIM_DIR="$IGOR_HOME/bin"
LOGS="$IGOR_HOME/logs"
INI_DIR="$IGOR_HOME/php"

# notify <message>: macOS notification, only when run by a site's watcher
# (IGOR_WATCH=1), where nobody sees the terminal
notify() {
    [ -n "${IGOR_WATCH:-}" ] || return 0
    local msg=${1//\\/\\\\}
    msg=${msg//\"/\\\"}
    osascript -e "display notification \"$msg\" with title \"igor\"" >/dev/null 2>&1 || true
}
die()  { echo "igor: $*" >&2; notify "$*"; exit 1; }
info() { echo "==> $*"; }

usage() {
    cat <<EOF
Usage: igor <command> [args]

  setup                     one-time: dnsmasq for *.$TLD, front proxy, local CA
  add <name> [--php 8.x] [--port N] [--docroot DIR]
                            serve the current project as https://<name>.$TLD
                            (e.g. 'igor add portal.valuequest')
  proxy <name> <port>       route https://<name>.$TLD to a service you run
                            yourself (Reverb, Mailpit UI, Vite, ...)
  service add <name> [--route PORT] [--env KEY=VALUE]... -- <command...>
                            run a background service (Redis, Mailpit, S3, ...)
                            in $IGOR_HOME/data/<name>; --route PORT also serves
                            its web UI as https://<name>.$TLD. Run it again to
                            change the command.
  rm <name>                 remove a site, service or route (project files and
                            service data are not touched)
  workers [<name>]          start the site's Procfile.dev processes (reverb,
                            queue, ...) and keep them running; rerun after
                            editing Procfile.dev
  start|stop|restart <name> control a site and its workers, or a service
                            (<name>:<worker> for a single worker); stopped
                            stays stopped after a restart of the Mac
  start | stop              everything: proxy, sites, workers and services
                            (e.g. to switch to Herd and back)
  list                      all sites, workers, services and routes with state
  logs <name>               follow a log (<name>:<worker>, or "proxy")
  logs --clear [<name>]     empty one log, or all of them
  info <name>               URLs and .env hints for internal access
  reload                    reload the front proxy config
  install [--check] [--force]
                            install the FrankenPHP suite (every PHP version in
                            the latest release); same as update, use it first
  update [--check] [--force]
                            install the latest suite release, then restart
                            everything on the new binaries
  uninstall <8.x> [--yes]   remove a PHP runtime the suite no longer ships
  refresh [<name>] [--restart]
                            regenerate all configs (PHP from each .php-version,
                            Procfile.dev workers, routes, newest PHP for the
                            proxy) and restart what changed; --restart
                            restarts everything running (after a PHP update)
  shims                     (re)create php/composer/frankenphp shims in
                            $IGOR_HOME/bin, plus php84, composer85, ... per
                            installed version (rerun after installing one)
EOF
}

# --- helpers ---------------------------------------------------------------

installed_versions() {
    # newest first, e.g. "8.5 8.4"
    # (skips the installer's php8.x.backup.<date> folders)
    ls -d "$PHP_ROOT"/php8.* 2>/dev/null | sed 's|.*/php||' | grep -E '^[0-9]+\.[0-9]+$' |
        sort -t. -k1,1nr -k2,2nr || true
}

php_bin() { echo "$PHP_ROOT/php$1/bin"; }

newest_php() {
    local v
    v=$(installed_versions | head -1)
    [ -n "$v" ] || die "no PHP runtime in $PHP_ROOT (install the suite with ./install.sh --versioned 8.x)"
    echo "$v"
}

check_name() {
    local label='[a-z0-9]([a-z0-9-]*[a-z0-9])?'
    [[ "$1" =~ ^$label(\.$label)*$ ]] ||
        die "invalid name '$1' (lowercase letters, digits, dashes; dots between parts)"
    [ "$1" != proxy ] || die "'proxy' is reserved for the front proxy"
}

registry_get() {   # registry_get <name> -> the line, or nothing
    [ -f "$REGISTRY" ] || return 0
    awk -F'\t' -v n="$1" '$1 == n' "$REGISTRY"
}

registry_field() { # registry_field <name> <column 1-6>
    registry_get "$1" | cut -f"$2"
}

site_docroot() {   # absolute document root of a site (column 6, default public)
    local dir rel
    dir=$(registry_field "$1" 5)
    rel=$(registry_field "$1" 6)
    rel=${rel:-public}
    if [ "$rel" = . ]; then echo "$dir"; else echo "$dir/$rel"; fi
}

next_port() {
    local max
    # sites only: routes and services use their own ports (8025, 9001, ...)
    max=$( { [ -f "$REGISTRY" ] && awk -F'\t' '$3 == "php" { print $2 }' "$REGISTRY"
             echo $((FIRST_PORT - 1)); } | sort -n | tail -1)
    echo $((max + 1))
}

port_in_use() {
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

label()  { echo "$LABEL_PREFIX.$1"; }
plist()  { echo "$AGENTS/$(label "$1").plist"; }
domain() { echo "gui/$(id -u)"; }

is_running() {   # loaded in launchd (it may be crash-looping, see is_alive)
    launchctl print "$(domain)/$(label "$1")" >/dev/null 2>&1
}

is_alive() {     # its process is up right now
    launchctl print "$(domain)/$(label "$1")" 2>/dev/null | grep -q $'^\tstate = running'
}

# check_alive <name> <log offset>: after a start, make sure the process stays
# up; if not, show what it logged since <offset> (bytes) and fail.
check_alive() {
    local name=$1 offset=$2 log="$LOGS/$1.log" out
    sleep 2
    is_alive "$name" && return 0
    out=$(tail -c +$((offset + 1)) "$log" 2>/dev/null | tail -15)
    [ -n "$out" ] || out=$(tail -15 "$log" 2>/dev/null)
    {
        echo ""
        echo "igor: $name is not running - it exited right after starting. Its log:"
        echo "${out:-  (empty)}" | sed 's/^/  | /'
        echo "launchd keeps retrying every 10s. Fix the command and run 'igor service add $name ...' again,"
        echo "or remove it with 'igor rm $name'."
    } >&2
    exit 1
}

xml_escape() {
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<< "$1"
}

# write_plist <name> <workdir> <PATH> <args...>
# PLIST_ENV="K=V<newline>..." adds environment variables; PLIST_WATCH="<path>
# <newline>..." makes it a watcher: run once whenever one of the paths changes
# instead of keeping a process alive.
# Leaves an identical plist untouched (macOS shows a "Background Activity"
# banner whenever one changes) and sets PLIST_CHANGED to 1 or 0.
PLIST_CHANGED=0
write_plist() {
    local name=$1 workdir=$2 path=$3 arg f
    shift 3
    f=$(plist "$name")
    mkdir -p "$AGENTS" "$LOGS"
    {
        cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(label "$name")</string>
  <key>ProgramArguments</key>
  <array>
EOF
        for arg in "$@"; do
            echo "    <string>$(xml_escape "$arg")</string>"
        done
        cat <<EOF
  </array>
  <key>WorkingDirectory</key><string>$(xml_escape "$workdir")</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$(xml_escape "$path")</string>
    <key>PHP_INI_SCAN_DIR</key><string>$(xml_escape "$INI_DIR")</string>
    <key>HOME</key><string>$(xml_escape "$HOME")</string>
EOF
        local kv
        while IFS= read -r kv; do
            [ -n "$kv" ] || continue
            echo "    <key>$(xml_escape "${kv%%=*}")</key><string>$(xml_escape "${kv#*=}")</string>"
        done <<< "${PLIST_ENV:-}"
        cat <<EOF
  </dict>
EOF
        if [ -n "${PLIST_WATCH:-}" ]; then
            echo "  <key>WatchPaths</key>"
            echo "  <array>"
            while IFS= read -r kv; do
                [ -n "$kv" ] || continue
                echo "    <string>$(xml_escape "$kv")</string>"
            done <<< "$PLIST_WATCH"
            echo "  </array>"
            echo "  <key>ProcessType</key><string>Background</string>"
        else
            echo "  <key>RunAtLoad</key><true/>"
            echo "  <key>KeepAlive</key><true/>"
            echo "  <key>ProcessType</key><string>Interactive</string>"
        fi
        cat <<EOF
  <key>StandardOutPath</key><string>$(xml_escape "$LOGS/$name.log")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$LOGS/$name.log")</string>
</dict>
</plist>
EOF
    } > "$f.tmp"
    if cmp -s "$f.tmp" "$f"; then
        rm -f "$f.tmp"; PLIST_CHANGED=0
    else
        mv "$f.tmp" "$f"; PLIST_CHANGED=1
    fi
}

# Starting an agent also enables it; 'igor stop' disables it, so a stopped
# agent stays stopped across logins (launchd loads every plist at login).
agent_start() {
    launchctl enable "$(domain)/$(label "$1")"
    is_running "$1" && return 0
    launchctl bootstrap "$(domain)" "$(plist "$1")"
}

agent_disable() {
    agent_stop "$1"
    launchctl disable "$(domain)/$(label "$1")"
}

agent_stop() {
    is_running "$1" || return 0
    launchctl bootout "$(domain)/$(label "$1")" 2>/dev/null || true
    # bootout returns before the job is gone (FrankenPHP shuts down gracefully);
    # wait, or an immediate agent_start sees it still loaded and does nothing
    local i=0
    while is_running "$1"; do
        [ $i -lt 150 ] || die "$1 did not stop within 30s (launchctl print $(domain)/$(label "$1"))"
        sleep 0.2; i=$((i + 1))
    done
}

# --- CLI shims ---------------------------------------------------------------

cmd_shims() {
    mkdir -p "$SHIM_DIR"
    cat > "$SHIM_DIR/igor-shim" <<'EOF'
#!/bin/bash
# igor shim - php, composer, frankenphp from the shared FrankenPHP runtimes.
#   php84, composer85, frankenphp84 ...  fixed version
#   php, composer, frankenphp            nearest .php-version from $PWD upwards
#                                        (or composer.json config.platform.php),
#                                        else the newest installed runtime
set -eu
PHP_ROOT="${IGOR_PHP_ROOT:-$HOME/frankenphp}"
name=$(basename "$0")
tool=${name%%[0-9]*}
digits=${name#"$tool"}
v="" from=""

if [ -n "$digits" ]; then
    v="${digits:0:1}.${digits:1}"
else
    d=$PWD
    while :; do
        if [ -f "$d/.php-version" ]; then
            from="$d/.php-version"
            v=$(tr -d '[:space:]' < "$from" | sed -E 's/^php//; s/^([0-9]+\.[0-9]+).*/\1/')
            break
        fi
        if [ -f "$d/composer.json" ]; then
            # no .php-version: composer.json's config.platform.php, if set
            v=$(plutil -extract config.platform.php raw -o - "$d/composer.json" 2>/dev/null |
                sed -nE 's/^([0-9]+\.[0-9]+)(\.[0-9]+)?$/\1/p' || true)
            if [ -n "$v" ]; then from="$d/composer.json"; break; fi
        fi
        [ "$d" = / ] && break
        d=$(dirname "$d")
    done
    if [ -z "$v" ]; then
        v=$(ls -d "$PHP_ROOT"/php8.* 2>/dev/null | sed 's|.*/php||' | grep -E '^[0-9]+\.[0-9]+$' |
            sort -t. -k1,1nr -k2,2nr | head -1 || true)
    fi
fi

bin="$PHP_ROOT/php$v/bin"
if [ -z "$v" ] || [ ! -x "$bin/$tool" ]; then
    echo "igor: PHP ${v:-?} is not installed in $PHP_ROOT${from:+ (wanted by $from)}" >&2
    exit 127
fi

# Child processes (composer scripts, artisan, #!/usr/bin/env php) get the same version
export PATH="$bin:$PATH"
export PHP_INI_SCAN_DIR="${PHP_INI_SCAN_DIR:-${IGOR_HOME:-$HOME/.igor}/php}"
exec "$bin/$tool" "$@"
EOF
    chmod +x "$SHIM_DIR/igor-shim"

    # drop links for runtimes that are gone, then link the current set
    find "$SHIM_DIR" -type l -lname igor-shim -delete
    local v short t
    for t in php composer frankenphp; do ln -s igor-shim "$SHIM_DIR/$t"; done
    for v in $(installed_versions); do
        short=${v/./}
        for t in php composer frankenphp; do ln -s igor-shim "$SHIM_DIR/$t$short"; done
    done

    echo "Shims in $SHIM_DIR: $(cd "$SHIM_DIR" && ls | grep -v "^igor-" | tr '\n' ' ')"
    case ":$PATH:" in
        *":$SHIM_DIR:"*) ;;
        *) echo "Put them first on PATH, at the end of ~/.zshrc (after Herd's lines):"
           echo "  export PATH=\"\$HOME/.igor/bin:\$PATH\"" ;;
    esac
}

proxy_bin() { echo "$(php_bin "$(newest_php)")/frankenphp"; }

reload_proxy() {
    is_running proxy || { echo "(front proxy not running - run 'igor setup')"; return 0; }
    "$(proxy_bin)" reload --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1 ||
        die "proxy reload failed - check: igor logs proxy"
}

# write_backend <name>: the site's FrankenPHP config. PHP gets HTTPS=on, so the
# app builds https:// URLs behind the front proxy without trusting any proxy.
# ":port" (any Host) because requests arrive with Host: <name>.test.
write_backend() {
    local name=$1 port dir f
    port=$(registry_field "$name" 2)
    dir=$(registry_field "$name" 5)
    f="$BACKENDS_DIR/$name.Caddyfile"
    mkdir -p "$BACKENDS_DIR"
    cat > "$f.tmp" <<EOF
# generated by igor - changes are overwritten
{
	frankenphp
	auto_https off
	admin off
	persist_config off
}

http://:$port {
	bind 127.0.0.1
	root * "$(site_docroot "$name")"
	php_server {
		env HTTPS on
	}
}
EOF
    if cmp -s "$f.tmp" "$f"; then rm -f "$f.tmp"; return 1; fi
    mv "$f.tmp" "$f"
}

# write_site <name>: backend config + LaunchAgent; SITE_CHANGED=1 if either changed
SITE_CHANGED=0
write_site() {
    local name=$1 php dir bin
    php=$(registry_field "$name" 4)
    dir=$(registry_field "$name" 5)
    bin=$(php_bin "$php")
    SITE_CHANGED=0
    write_backend "$name" && SITE_CHANGED=1
    write_plist "$name" "$dir" "$bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
        "$bin/frankenphp" run --config "$BACKENDS_DIR/$name.Caddyfile" --adapter caddyfile
    [ "$PLIST_CHANGED" = 0 ] || SITE_CHANGED=1
}

write_route() { # write_route <name> <port>
    mkdir -p "$SITES_DIR"
    cat > "$SITES_DIR/$1.caddy" <<EOF
$1.$TLD {
	reverse_proxy 127.0.0.1:$2
}
EOF
}

# --- commands --------------------------------------------------------------

cmd_setup() {
    command -v brew >/dev/null || die "Homebrew is required"
    command -v direnv >/dev/null || { info "Installing direnv"; brew install direnv; }
    brew list dnsmasq >/dev/null 2>&1 || { info "Installing dnsmasq"; brew install dnsmasq; }

    local prefix conf
    prefix=$(brew --prefix)
    conf="$prefix/etc/dnsmasq.conf"
    if ! grep -q "^# igor" "$conf" 2>/dev/null; then
        info "Pointing *.$TLD to 127.0.0.1 in $conf"
        printf '\n# igor\naddress=/.%s/127.0.0.1\nlisten-address=127.0.0.1\n' "$TLD" >> "$conf"
    fi
    info "Starting dnsmasq (needs sudo for port 53)"
    sudo brew services restart dnsmasq

    if [ "$(cat "/etc/resolver/$TLD" 2>/dev/null)" != "nameserver 127.0.0.1" ]; then
        info "Creating /etc/resolver/$TLD (sudo)"
        sudo mkdir -p /etc/resolver
        echo "nameserver 127.0.0.1" | sudo tee "/etc/resolver/$TLD" >/dev/null
    fi

    mkdir -p "$IGOR_HOME" "$SITES_DIR" "$LOGS" "$INI_DIR"
    touch "$REGISTRY"

    if [ ! -f "$INI_DIR/99-igor.ini" ]; then
        cat > "$INI_DIR/99-igor.ini" <<'EOF'
; Shared dev settings for all sites and the CLI (via PHP_INI_SCAN_DIR)
memory_limit = 512M
upload_max_filesize = 64M
post_max_size = 64M
max_execution_time = 120
display_errors = On
error_reporting = E_ALL
date.timezone = Europe/Zurich
opcache.enable = 1
opcache.enable_cli = 0
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
EOF
    fi

    if [ ! -f "$CADDYFILE" ]; then
        cat > "$CADDYFILE" <<EOF
{
	local_certs
	admin localhost:2019
	# Listens on all interfaces, so sites are reachable from your LAN unless
	# the macOS firewall blocks it. Binding only 127.0.0.1 to ports 80/443
	# needs root on macOS.
}

import $SITES_DIR/*.caddy
EOF
    fi

    if pgrep -qf "Herd" 2>/dev/null; then
        echo "Warning: Herd seems to be running - quit it, it holds ports 80/443." >&2
    fi

    info "Starting front proxy"
    write_plist proxy "$IGOR_HOME" "$(php_bin "$(newest_php)"):/usr/bin:/bin:/usr/sbin:/sbin" \
        "$(proxy_bin)" run --config "$CADDYFILE" --adapter caddyfile
    agent_stop proxy
    agent_start proxy
    sleep 2

    info "Creating PHP CLI shims"
    cmd_shims

    info "Trusting the local CA (macOS asks for your password)"
    "$(proxy_bin)" trust || echo "Trust failed - retry with: $(proxy_bin) trust" >&2

    cat <<EOF

Done. Make sure your shell loads direnv (zsh: eval "\$(direnv hook zsh)" in ~/.zshrc).
Then, in a project:  igor add <name>
EOF
}

# composer_platform_php <dir>: "8.4" from composer.json's config.platform.php
# ("8.4", "8.4.12", ...), or nothing if it's not set
composer_platform_php() {
    local v
    [ -f "$1/composer.json" ] || return 0
    v=$(plutil -extract config.platform.php raw -o - "$1/composer.json" 2>/dev/null || true)
    [[ "$v" =~ ^([0-9]+\.[0-9]+)(\.[0-9]+)?$ ]] && echo "${BASH_REMATCH[1]}"
    return 0
}

cmd_add() {
    local name="" php="" port="" docroot="" dir
    dir=$(pwd)
    while [ $# -gt 0 ]; do
        case "$1" in
            --php)     php=${2:-}; shift 2 ;;
            --port)    port=${2:-}; shift 2 ;;
            --docroot) docroot=${2:-}; shift 2 ;;
            -*)     die "unknown option $1" ;;
            *)      [ -z "$name" ] || die "unexpected argument '$1'"; name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: igor add <name> [--php 8.x] [--port N] [--docroot DIR]  (e.g. igor add portal.valuequest)"
    name=${name%.$TLD}   # accept 'portal.valuequest.test' too
    check_name "$name"
    [ -f "$CADDYFILE" ] || die "run 'igor setup' first"
    [ -z "$(registry_get "$name")" ] || die "'$name' already exists (igor rm $name)"
    # document root, relative to the project: --docroot, else public/ if
    # there is one (Laravel, Symfony, ...), else the project itself (WordPress)
    if [ -z "$docroot" ]; then
        if [ -d "$dir/public" ]; then docroot=public; else docroot=.; fi
    fi
    docroot=${docroot%/}; docroot=${docroot#./}; docroot=${docroot:-.}
    [[ "$docroot" != /* && "$docroot" != ..* && "$docroot" != */..* ]] ||
        die "--docroot must be a folder inside the project (e.g. public, web, .)"
    [ -d "$dir/$docroot" ] || die "no $docroot/ in $dir - run this in the project root"
    local existing
    existing=$(awk -F'\t' -v d="$dir" '$5 == d { print $1 }' "$REGISTRY" 2>/dev/null || true)
    [ -z "$existing" ] || die "this folder is already served as '$existing'"

    # PHP version: --php, else .php-version, else composer.json's
    # config.platform.php, else the newest installed
    local from="--php"
    if [ -z "$php" ] && [ -f "$dir/.php-version" ]; then
        php=$(tr -d '[:space:]' < "$dir/.php-version"); from=".php-version"
    fi
    if [ -z "$php" ]; then
        php=$(composer_platform_php "$dir"); from="composer.json (config.platform.php)"
    fi
    if [ -z "$php" ]; then
        php=$(newest_php); from="newest installed"
    fi
    [ -x "$(php_bin "$php")/frankenphp" ] ||
        die "PHP $php (from $from) is not installed in $PHP_ROOT/php$php - run 'igor install', or pick one with --php 8.x"
    echo "$php" > "$dir/.php-version"

    [ -n "$port" ] || port=$(next_port)
    while port_in_use "$port"; do port=$((port + 1)); done

    # direnv: shared runtime on PATH, shared ini for the CLI too
    if [ ! -f "$dir/.envrc" ] || ! grep -q "igor" "$dir/.envrc"; then
        cat >> "$dir/.envrc" <<'EOF'
# igor: PHP runtime from .php-version
PATH_add "$HOME/frankenphp/php$(tr -d '[:space:]' < .php-version)/bin"
export PHP_INI_SCAN_DIR="$HOME/.igor/php"
EOF
        command -v direnv >/dev/null && (cd "$dir" && direnv allow)
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$port" php "$php" "$dir" "$docroot" >> "$REGISTRY"
    write_site "$name"
    write_route "$name" "$port"
    agent_start "$name"
    reload_proxy
    if [ -f "$dir/Procfile.dev" ]; then
        echo "Workers from Procfile.dev:"
        sync_workers "$name"
    fi
    write_watcher "$name"

    cat <<EOF
https://$name.$TLD  ->  http://127.0.0.1:$port  (PHP $php from $from, serving $docroot/)
Pinned in .php-version - add .php-version and .envrc to git if the team should share it.
EOF
}

cmd_proxy() {
    local name=${1:-} port=${2:-}
    [ -n "$name" ] && [ -n "$port" ] || die "usage: igor proxy <name> <port>"
    check_name "$name"
    [[ "$port" =~ ^[0-9]+$ ]] || die "port must be a number"
    [ -z "$(registry_get "$name")" ] || die "'$name' already exists"
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$port" proxy - - >> "$REGISTRY"
    write_route "$name" "$port"
    reload_proxy
    echo "https://$name.$TLD  ->  http://127.0.0.1:$port  (you run the service yourself)"
}

# --- services (Redis, Mailpit, S3, ...) ----------------------------------------
# Registry line: name <TAB> route port or "-" <TAB> service <TAB> - <TAB> data dir

cmd_service() {
    local sub=${1:-}
    shift || true
    case "$sub" in
        add) service_add "$@" ;;
        rm)  cmd_rm "$@" ;;
        *)   die "usage: igor service add <name> [--route PORT] [--env KEY=VALUE]... -- <command...>" ;;
    esac
}

service_add() {
    local name="" route="-" envs="" cmd exe data existing
    while [ $# -gt 0 ]; do
        case "$1" in
            --route) route=${2:-}; shift 2 ;;
            --env)   [[ "${2:-}" == ?*=* ]] || die "--env needs KEY=VALUE"
                     envs="$envs${2}"$'\n'; shift 2 ;;
            --)      shift; break ;;
            -*)      die "unknown option $1" ;;
            *)       [ -z "$name" ] || die "unexpected argument '$1' (put the command after --)"
                     name=$1; shift ;;
        esac
    done
    [ -n "$name" ] && [ $# -gt 0 ] ||
        die "usage: igor service add <name> [--route PORT] [--env KEY=VALUE]... -- <command...>"
    check_name "$name"
    [ "$route" = - ] || [[ "$route" =~ ^[0-9]+$ ]] || die "--route needs a port number"
    [ -f "$CADDYFILE" ] || die "run 'igor setup' first"

    existing=$(registry_field "$name" 3)
    [ -z "$existing" ] || [ "$existing" = service ] ||
        die "'$name' already exists as a $existing (igor rm $name)"

    # launchd needs a full path; look in Homebrew too
    cmd=$1; exe=$1; shift
    if [[ "$exe" != */* ]]; then
        exe=$(PATH="/opt/homebrew/bin:/usr/local/bin:$PATH" command -v "$cmd" || true)
        [ -n "$exe" ] || die "'$cmd' not found - install it first (e.g. brew install $cmd)"
    fi
    [ -x "$exe" ] || die "$exe is not executable"

    data="$IGOR_HOME/data/$name"
    mkdir -p "$data"

    # replace the registry line (re-adding updates the service)
    if [ -n "$existing" ]; then
        awk -F'\t' -v n="$name" '$1 != n' "$REGISTRY" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$route" service - "$data" >> "$REGISTRY"

    PLIST_ENV="$envs" write_plist "$name" "$data" \
        "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" "$exe" "$@"
    local offset
    offset=$({ wc -c < "$LOGS/$name.log"; } 2>/dev/null || echo 0)
    [ "$PLIST_CHANGED" = 0 ] || agent_stop "$name"
    agent_start "$name"

    if [ "$route" != - ]; then
        write_route "$name" "$route"
    else
        rm -f "$SITES_DIR/$name.caddy"
    fi
    reload_proxy

    echo "$name: $exe $*"
    echo "  data: $data   log: igor logs $name"
    [ "$route" = - ] || echo "  https://$name.$TLD  ->  http://127.0.0.1:$route"
    check_alive "$name" "$offset"
}

# --- refresh -------------------------------------------------------------------

registry_set() {   # registry_set <name> <column 1-5> <value>
    awk -F'\t' -v OFS='\t' -v n="$1" -v c="$2" -v v="$3" '$1 == n { $c = v } { print }' \
        "$REGISTRY" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"
}

# bounce <agent> <changed> <force>: restart a running agent if its config
# changed or if forced; a stopped agent stays stopped
bounce() {
    local agent=$1 changed=$2 force=$3
    is_running "$agent" || return 0
    [ "$changed" = 1 ] || [ "$force" = 1 ] || return 0
    agent_stop "$agent"; agent_start "$agent"
    echo "  restarted ${agent/@/:}"
}

# A site's watcher ("<site>~watch", shown as <site>:watch) runs
# 'igor refresh <site>' whenever the project's .php-version, composer.json or
# Procfile.dev changes, e.g. on 'git checkout' of a branch with another PHP
# version.
watcher() { echo "$1~watch"; }

write_watcher() {   # write_watcher <site>
    local site=$1 dir w existed=0 running=0
    dir=$(registry_field "$site" 5)
    w=$(watcher "$site")
    [ -f "$(plist "$w")" ] && existed=1
    is_running "$w" && running=1
    PLIST_WATCH="$dir/.php-version"$'\n'"$dir/composer.json"$'\n'"$dir/Procfile.dev" PLIST_ENV="IGOR_WATCH=1" \
        write_plist "$w" "$dir" "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin" "$IGOR_BIN" refresh "$site"
    if [ "$existed" = 0 ]; then
        agent_start "$w"
    elif [ "$PLIST_CHANGED" = 1 ] && [ "$running" = 1 ]; then
        agent_stop "$w"; agent_start "$w"
    fi
}

# refresh_site <name> <force>: PHP from .php-version, configs, route, workers
refresh_site() {
    local name=$1 force=$2 port php dir want w
    port=$(registry_field "$name" 2)
    php=$(registry_field "$name" 4)
    dir=$(registry_field "$name" 5)
    info "$name"
    if [ ! -d "$dir" ]; then
        echo "  $dir is gone - skipped (igor rm $name)" >&2; return 0
    fi
    # wanted version: .php-version, else composer.json's config.platform.php
    # (e.g. a branch that doesn't commit .php-version); not written back
    local from=".php-version"
    want=""
    [ -f "$dir/.php-version" ] && want=$(tr -d '[:space:]' < "$dir/.php-version")
    if [ -z "$want" ]; then
        want=$(composer_platform_php "$dir"); from="composer.json"
    fi
    if [ -z "$want" ]; then
        echo "  no .php-version and no config.platform.php in composer.json - staying on PHP $php" >&2
        notify "$name: no .php-version and no config.platform.php in this branch - still on PHP $php."
    elif [ "$want" != "$php" ]; then
        if [ -x "$(php_bin "$want")/frankenphp" ]; then
            registry_set "$name" 4 "$want"
            echo "  PHP $php -> $want (from $from)"
            notify "$name now runs PHP $want (was $php)"
        else
            echo "  $from wants PHP $want, which is not installed - staying on $php" >&2
            notify "$name: $from wants PHP $want, which is not installed - still on PHP $php. Run 'igor install'."
        fi
    fi
    write_site "$name"
    write_route "$name" "$port"
    bounce "$name" "$SITE_CHANGED" "$force"
    sync_workers "$name" keep-stopped
    if [ "$force" = 1 ]; then
        for w in $(site_workers "$name"); do bounce "$w" 0 1; done
    fi
    # the watcher doesn't rewrite (and so restart) itself
    [ -n "${IGOR_WATCH:-}" ] || write_watcher "$name"
}

cmd_refresh() {
    local force=0 only="" name port type php dir
    while [ $# -gt 0 ]; do
        case "$1" in
            --restart) force=1; shift ;;
            -*) die "usage: igor refresh [<name>] [--restart]" ;;
            *)  [ -z "$only" ] || die "usage: igor refresh [<name>] [--restart]"; only=$1; shift ;;
        esac
    done
    [ -f "$CADDYFILE" ] || die "run 'igor setup' first"

    if [ -n "$only" ]; then
        require_php_site "$only"
        [ -z "${IGOR_WATCH:-}" ] || echo "--- $(date '+%Y-%m-%d %H:%M:%S') .php-version, composer.json or Procfile.dev changed"
        refresh_site "$only" "$force"
        reload_proxy
        return 0
    fi

    cmd_shims >/dev/null
    info "Shims updated"

    info "Front proxy (PHP $(newest_php))"
    write_plist proxy "$IGOR_HOME" "$(php_bin "$(newest_php)"):/usr/bin:/bin:/usr/sbin:/sbin" \
        "$(proxy_bin)" run --config "$CADDYFILE" --adapter caddyfile
    bounce proxy "$PLIST_CHANGED" "$force"

    # read the registry up front: refresh_site rewrites it
    local entries
    entries=$(cat "$REGISTRY")
    while IFS=$'\t' read -r name port type php dir _ <&3; do
        [ -n "$name" ] || continue
        case "$type" in
            php)
                refresh_site "$name" "$force"
                ;;
            service)
                info "$name (service)"
                if [ "$port" != - ]; then write_route "$name" "$port"; else rm -f "$SITES_DIR/$name.caddy"; fi
                bounce "$name" 0 "$force"
                ;;
            proxy)
                write_route "$name" "$port"
                ;;
        esac
    done 3<<< "$entries"

    reload_proxy
    echo ""
    cmd_list
}

# --- update (FrankenPHP suite) ---------------------------------------------------
# Installs the latest suite release with its own install.sh --versioned.
# The suite rebuilds and re-uploads its archives daily into a release tagged
# with the FrankenPHP version, so igor compares versions, not tags or upload
# times: the release's versions.json ({"frankenphp": "1.13.5", "php85":
# "8.5.13", ...}) against the installed PHP and php8.x/.igor-release
# ("tag=v1.13.5 frankenphp=1.13.5 php=8.5.13"; the binary doesn't know its
# FrankenPHP version). Without versions.json only a new tag counts as an update.

SUITE_REPO="${IGOR_SUITE_REPO:-value-quest/franken-php}"

json_get() { plutil -extract "$1" raw -o - - <<< "$2" 2>/dev/null || true; }   # json_get <path> <json>; "" if absent

marker_get() {     # marker_get <8.x> <key>
    local kv
    for kv in $(cat "$PHP_ROOT/php$1/.igor-release" 2>/dev/null); do
        [ "${kv%%=*}" = "$2" ] && { echo "${kv#*=}"; return 0; }
    done
    return 0
}
installed_php() { "$PHP_ROOT/php$1/bin/php" -r 'echo PHP_VERSION;' 2>/dev/null || true; }

# cmd_update <install|update> [--check] [--force]: one command under two
# names - 'install' on a new Mac, 'update' later; both install what's missing
cmd_update() {
    local cmd=$1; shift
    local check=0 force=0 arch json tag n i aname versions="" fp_avail
    local v short avail inst_php inst_fp pending="" tmp b got shorts="" dropped=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --check) check=1; shift ;;
            --force) force=1; shift ;;
            *) die "usage: igor $cmd [--check] [--force]" ;;
        esac
    done

    case "$(uname -m)" in
        arm64)  arch=arm64 ;;
        x86_64) arch=amd64 ;;
        *)      die "unsupported architecture $(uname -m)" ;;
    esac

    json=$(curl -fsSL "https://api.github.com/repos/$SUITE_REPO/releases/latest") ||
        die "could not reach GitHub for $SUITE_REPO"
    tag=$(json_get tag_name "$json")
    [[ "$tag" =~ ^v?[0-9][0-9A-Za-z.+-]*$ ]] || die "unexpected release tag '$tag'"
    n=$(json_get assets "$json"); n=${n:-0}
    for ((i = 0; i < n; i++)); do
        aname=$(json_get "assets.$i.name" "$json")
        [[ "$aname" =~ ^frankenphp-darwin-$arch-(php[0-9]+)\.tar\.gz$ ]] && shorts="$shorts ${BASH_REMATCH[1]}"
        [ "$aname" = versions.json ] && versions=$(curl -fsSL \
            "https://github.com/$SUITE_REPO/releases/download/$tag/versions.json" || true)
    done
    [ -n "$shorts" ] || die "release $tag has no darwin-$arch builds"
    fp_avail=$(json_get frankenphp "$versions")

    echo "Latest suite release: $tag ($SUITE_REPO)${fp_avail:+, FrankenPHP $fp_avail}"
    [ -n "$versions" ] || echo "  (no versions.json in this release - only a new tag counts as an update)"
    printf '  %-6s %-28s %s\n' PHP INSTALLED AVAILABLE
    for short in $shorts; do
        v="${short:3:1}.${short:4}"            # php84 -> 8.4
        avail=$(json_get "$short" "$versions")
        inst_php=$(installed_php "$v")
        inst_fp=$(marker_get "$v" frankenphp)
        if [ ! -d "$PHP_ROOT/php$v" ]; then
            printf '  %-6s %-28s %s\n' "$v" "not installed" "${avail:-$tag}"
            pending="$pending $v"; continue
        fi
        if [ -n "$avail" ]; then b="$avail (FrankenPHP $fp_avail)"; else b=$tag; fi
        printf '  %-6s %-28s %s\n' "$v" "${inst_php:-?} (FrankenPHP ${inst_fp:-?})" "$b"
        if [ "$force" = 1 ]; then
            pending="$pending $v"
        elif [ -n "$avail" ] && [ -n "$fp_avail" ]; then
            [ "$inst_php" = "$avail" ] && [ "$inst_fp" = "$fp_avail" ] || pending="$pending $v"
        else
            [ "$(marker_get "$v" tag)" = "$tag" ] || pending="$pending $v"
        fi
    done

    # installed runtimes the suite no longer ships
    for v in $(installed_versions); do
        case " $shorts " in *" php${v/./} "*) continue ;; esac
        printf '  %-6s %-28s %s\n' "$v" "$(installed_php "$v") (FrankenPHP $(marker_get "$v" frankenphp))" \
            "no longer in the release"
        dropped="$dropped $v"
    done
    for v in $dropped; do
        echo "PHP $v is no longer shipped: switch its projects to another version, then 'igor uninstall $v'."
    done

    if [ -z "$pending" ]; then
        if [ "$cmd" = install ]; then echo "Everything is installed and up to date."; else echo "Up to date."; fi
        return 0
    fi
    if [ "$check" = 1 ]; then echo "Run 'igor $cmd' to install PHP$pending."; return 0; fi

    tmp=$(mktemp -d "${TMPDIR:-/tmp}/igor-update.XXXXXX")
    # expand $tmp now: the EXIT trap runs after cmd_update's locals are gone
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT
    for v in $pending; do
        short="php${v/./}"
        info "PHP $v: downloading $tag"
        curl -fL --retry 2 -o "$tmp/$short.tar.gz" \
            "https://github.com/$SUITE_REPO/releases/download/$tag/frankenphp-darwin-$arch-$short.tar.gz" ||
            die "download failed for PHP $v"
        mkdir "$tmp/$short"
        tar -xzf "$tmp/$short.tar.gz" -C "$tmp/$short"
        [ -x "$tmp/$short/install.sh" ] || die "no install.sh in the PHP $v archive"

        info "PHP $v: installing"
        "$tmp/$short/install.sh" --versioned "$v"
        "$PHP_ROOT/php$v/bin/frankenphp" version >/dev/null && got=$(installed_php "$v") && [ -n "$got" ] ||
            die "PHP $v does not run after the install - the previous version is in $PHP_ROOT/php$v.backup.*"
        avail=$(json_get "$short" "$versions")
        if [ -n "$avail" ] && [ "$got" != "$avail" ]; then
            echo "  note: versions.json says $avail, the installed binary is $got (release changed during download?)" >&2
        fi
        echo "tag=$tag frankenphp=${fp_avail:-unknown} php=$got" > "$PHP_ROOT/php$v/.igor-release"
        echo "  PHP $got, FrankenPHP ${fp_avail:-?}"

        # keep only the newest backup the installer made
        for b in $(ls -dt "$PHP_ROOT/php$v.backup."* 2>/dev/null | tail -n +2); do
            [[ "$b" == "$PHP_ROOT/php$v.backup."* ]] && rm -rf "$b"
        done
    done

    if [ ! -f "$CADDYFILE" ]; then
        echo "Installed. Next: igor setup"
        return 0
    fi
    info "Restarting everything on the new binaries"
    cmd_refresh --restart
}

# igor uninstall <8.x> [--yes]: remove a PHP runtime (not igor itself)
cmd_uninstall() {
    local v="" yes=0 users backups b answer
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) yes=1; shift ;;
            -*)       die "unknown option $1" ;;
            *)        [ -z "$v" ] || die "unexpected argument '$1'"; v=$1; shift ;;
        esac
    done
    [[ "$v" =~ ^[0-9]+\.[0-9]+$ ]] ||
        die "usage: igor uninstall <8.x> [--yes]   removes a PHP runtime from $PHP_ROOT (not igor)"
    [ -d "$PHP_ROOT/php$v" ] || die "PHP $v is not installed in $PHP_ROOT"

    users=$(awk -F'\t' -v v="$v" '$3 == "php" && $4 == v { print "  " $1 "  (" $5 ")" }' "$REGISTRY" 2>/dev/null || true)
    [ -z "$users" ] || die "PHP $v is still used by:
$users
Change .php-version in those projects to another version, run 'igor refresh', then try again."
    if [ -f "$CADDYFILE" ] && [ "$(installed_versions | grep -vxF "$v" | head -1)" = "" ]; then
        die "PHP $v is the only runtime left - the front proxy needs one (install another with 'igor install' first)"
    fi

    backups=$(ls -d "$PHP_ROOT/php$v.backup."* 2>/dev/null || true)
    echo "This removes:"
    echo "  $PHP_ROOT/php$v  (PHP $(installed_php "$v"))"
    for b in $backups; do echo "  $b"; done
    if [ "$yes" = 0 ]; then
        [ -t 0 ] || die "not a terminal - pass --yes to confirm"
        read -r -p "Continue? [y/N] " answer
        [[ "$answer" =~ ^[yY]$ ]] || die "cancelled"
    fi

    rm -rf "${PHP_ROOT:?}/php$v"
    for b in $backups; do
        [[ "$b" == "$PHP_ROOT/php$v.backup."* ]] && rm -rf "$b"
    done
    echo "Removed PHP $v"

    if [ -f "$CADDYFILE" ]; then
        info "Moving the front proxy and shims to the remaining runtimes"
        cmd_refresh
    else
        cmd_shims >/dev/null
    fi
}

# --- workers (Procfile.dev) --------------------------------------------------
# A worker is a launchd agent named "<site>@<worker>"; users write <site>:<worker>.

agent_name() {   # <site>:<worker> -> <site>@<worker>, <site>:watch -> <site>~watch
    case "$1" in
        *:watch) echo "${1%:watch}~watch" ;;
        *)       echo "${1/:/@}" ;;
    esac
}

site_workers() {   # worker agent names of a site, e.g. "portal@queue"
    local f
    for f in "$AGENTS/$(label "$1")@"*.plist; do
        [ -e "$f" ] || continue
        f=${f##*/}; f=${f%.plist}; echo "${f#"$LABEL_PREFIX".}"
    done
}

remove_agent() {
    agent_stop "$1"
    rm -f "$(plist "$1")"
}

# Workers start through this script, so macOS names it (not "bash") in its
# background-activity banners.
write_worker_runner() {
    local f="$SHIM_DIR/igor-worker"
    mkdir -p "$SHIM_DIR"
    printf '#!/bin/bash\n# igor: runs one Procfile.dev line\nexec /bin/bash -c "$1"\n' > "$f.tmp"
    if cmp -s "$f.tmp" "$f"; then rm -f "$f.tmp"; else mv "$f.tmp" "$f"; chmod +x "$f"; fi
}

# sync_workers <site> [keep-stopped]: with keep-stopped, a worker that exists
# but is stopped stays stopped (new workers still start)
sync_workers() {
    local site=$1 mode=${2:-} dir php procfile line wname cmd agent keep="" existed running
    dir=$(registry_field "$site" 5)
    php=$(registry_field "$site" 4)
    procfile="$dir/Procfile.dev"

    if [ -f "$procfile" ]; then
        write_worker_runner
        while IFS= read -r line <&3 || [ -n "$line" ]; do
            line=${line%$'\r'}
            [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
            [[ "$line" =~ ^([A-Za-z0-9_-]+):[[:space:]]*(.+)$ ]] ||
                die "Procfile.dev: can't read '$line' (expected 'name: command')"
            wname=${BASH_REMATCH[1]}; cmd=${BASH_REMATCH[2]}
            [ "$wname" != watch ] || die "Procfile.dev: 'watch' is reserved for igor's watcher - rename that worker"
            agent="$site@$wname"
            keep="$keep $agent "
            existed=0; [ -f "$(plist "$agent")" ] && existed=1
            running=0; is_running "$agent" && running=1
            write_plist "$agent" "$dir" \
                "$(php_bin "$php"):$dir/vendor/bin:$dir/node_modules/.bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
                "$SHIM_DIR/igor-worker" "$cmd"
            if [ "$PLIST_CHANGED" = 1 ]; then
                agent_stop "$agent"
                echo "  $site:$wname  $cmd"
            fi
            if [ "$mode" != keep-stopped ] || [ "$existed" = 0 ] || [ "$running" = 1 ]; then
                agent_start "$agent"
            fi
        done 3< "$procfile"
    fi

    for agent in $(site_workers "$site"); do
        case "$keep" in
            *" $agent "*) ;;
            *) remove_agent "$agent"; echo "  $site:${agent#*@}  removed" ;;
        esac
    done
}

site_for_dir() {
    awk -F'\t' -v d="$1" '$5 == d && $3 == "php" { print $1 }' "$REGISTRY" 2>/dev/null || true
}

cmd_workers() {
    local site=${1:-}
    [ -n "$site" ] || site=$(site_for_dir "$(pwd)")
    [ -n "$site" ] || die "this folder is not an igor site - run 'igor add <name>' first, or 'igor workers <name>'"
    require_php_site "$site"
    [ -f "$(registry_field "$site" 5)/Procfile.dev" ] ||
        echo "No Procfile.dev in $(registry_field "$site" 5) - removing any workers of $site"
    sync_workers "$site"
    local w
    for w in $(site_workers "$site"); do
        printf '  %-36s %s\n' "${w/@/:}" "$(is_running "$w" && echo running || echo stopped)"
    done
}

cmd_rm() {
    local name=${1:-}
    [ -n "$(registry_get "$name")" ] || die "no site, service or route '$name'"
    local w type
    type=$(registry_field "$name" 3)
    for w in $(site_workers "$name"); do remove_agent "$w"; done
    remove_agent "$(watcher "$name")"
    agent_stop "$name"
    rm -f "$(plist "$name")" "$SITES_DIR/$name.caddy" "$BACKENDS_DIR/$name.Caddyfile"
    awk -F'\t' -v n="$name" '$1 != n' "$REGISTRY" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"
    reload_proxy
    if [ "$type" = service ]; then
        echo "Removed $name (data left in $IGOR_HOME/data/$name)"
    else
        echo "Removed $name (project files, .php-version and .envrc left as they are)"
    fi
}

require_php_site() {
    [ -n "$(registry_get "$1")" ] || die "no site '$1'"
    [ "$(registry_field "$1" 3)" = php ] || die "'$1' is a proxy route - start that service yourself"
}

# targets <name> | <name>:<worker> -> agent names (the site and all its workers)
targets() {
    local name=${1:-}
    case "$name" in
        *:*) [ -f "$(plist "$(agent_name "$name")")" ] || die "no worker '$name'"
             agent_name "$name" ;;
        *)   if [ "$(registry_field "$name" 3)" = service ]; then echo "$name"
             else require_php_site "$name"; echo "$name"; site_workers "$name"
                  [ -f "$(plist "$(watcher "$name")")" ] && watcher "$name"; fi ;;
    esac
}

control() {   # control start|stop|restart <name>
    local action=$1 name=${2:-} list a
    list=$(targets "$name")
    # (re)generate a site's config on start/restart; a running site with a
    # changed config is restarted even on 'start'
    if [ "$action" != stop ] && [ "$(registry_field "$name" 3)" = php ]; then
        write_site "$name"
        [ "$SITE_CHANGED" = 0 ] || agent_stop "$name"
    fi
    for a in $list; do
        case "$action" in
            stop)    agent_disable "$a" ;;
            start)   agent_start "$a" ;;
            restart) agent_stop "$a"; agent_start "$a" ;;
        esac
    done
    echo "$name ${action/%p/pp}ed"
}

# everything igor runs: sites + workers and services (registry order)
all_names() {
    [ -f "$REGISTRY" ] || return 0
    awk -F'\t' '$3 == "php" || $3 == "service" { print $1 }' "$REGISTRY"
}

start_all() {
    if ! is_running proxy && { port_in_use 80 || port_in_use 443; }; then
        die "ports 80/443 are in use - quit Herd (or whatever holds them) first"
    fi
    info "Front proxy"
    agent_start proxy
    local name
    for name in $(all_names); do control start "$name"; done
    echo ""
    echo "igor is running: https://<name>.$TLD"
}

stop_all() {
    local name
    for name in $(all_names); do control stop "$name"; done
    info "Front proxy"
    agent_disable proxy
    echo ""
    echo "igor is stopped and stays stopped after a restart. Ports 80/443 are free,"
    echo "so you can start Herd now. Back to igor: quit Herd, then 'igor start'."
}

cmd_start()   { if [ $# -eq 0 ]; then start_all; else control start "$@"; fi; }
cmd_stop()    { if [ $# -eq 0 ]; then stop_all;  else control stop "$@"; fi; }
cmd_restart() { control restart "$@"; }

cmd_list() {
    [ -s "$REGISTRY" ] || { echo "Nothing yet - run 'igor add <name>' in a project."; return 0; }
    printf '%-28s %-6s %-6s %-8s %s\n' NAME PORT PHP STATE DIR
    local name port type php dir docroot state w
    while IFS=$'\t' read -r name port type php dir docroot; do
        if [ "$type" = proxy ]; then
            state=$(port_in_use "$port" && echo up || echo down)
        elif [ "$type" = service ]; then
            php=svc
            state=$(is_running "$name" && echo running || echo stopped)
        else
            state=$(is_running "$name" && echo running || echo stopped)
        fi
        [ "$type" != php ] || [ "${docroot:-public}" = public ] || dir="$dir  (docroot: $docroot)"
        printf '%-28s %-6s %-6s %-8s %s\n' "$name" "$port" "$php" "$state" "$dir"
        [ "$type" = php ] || continue
        for w in $(site_workers "$name"); do
            printf '  %-26s %-6s %-6s %-8s\n' ":${w#*@}" "" "" "$(is_running "$w" && echo running || echo stopped)"
        done
    done < "$REGISTRY"
    echo ""
    echo "Front proxy: $(is_running proxy && echo running || echo stopped)"
}

cmd_logs() {
    local name="" clear=0 f
    while [ $# -gt 0 ]; do
        case "$1" in
            --clear) clear=1; shift ;;
            -*)      die "unknown option $1" ;;
            *)       [ -z "$name" ] || die "unexpected argument '$1'"; name=$1; shift ;;
        esac
    done

    if [ "$clear" = 1 ]; then
        # truncate, don't delete: launchd keeps the files open and appends
        if [ -z "$name" ]; then
            for f in "$LOGS"/*.log; do [ -e "$f" ] && : > "$f"; done
            echo "Cleared all logs in $LOGS"
        else
            f="$LOGS/$(agent_name "$name").log"
            [ -f "$f" ] || die "no log for '$name'"
            : > "$f"
            echo "Cleared $f"
        fi
        return 0
    fi

    [ -n "$name" ] || die "usage: igor logs <name|proxy>  or  igor logs --clear [<name>]"
    f="$LOGS/$(agent_name "$name").log"
    [ -f "$f" ] || die "no log for '$name' yet"
    tail -f "$f"
}

cmd_info() {
    local name=${1:-} port
    [ -n "$(registry_get "$name")" ] || die "no site '$name'"
    port=$(registry_field "$name" 2)
    if [ "$(registry_field "$name" 3)" = service ]; then
        echo "Command:   $(plutil -extract ProgramArguments json -o - "$(plist "$name")" 2>/dev/null)"
        echo "Data:      $(registry_field "$name" 5)"
        echo "Log:       $LOGS/$name.log"
        [ "$port" = - ] || echo "Browser:   https://$name.$TLD -> http://127.0.0.1:$port"
        return 0
    fi
    cat <<EOF
Browser:   https://$name.$TLD
Internal:  http://127.0.0.1:$port     (server-to-server, no TLS)

.env hints for apps talking to '$name' (Laravel-style examples):
  # SSO: browser redirects public, back-channel internal
  SSO_URL=https://$name.$TLD
  SSO_INTERNAL_URL=http://127.0.0.1:$port
  # Reverb: server publishes internally, browser connects via the proxy
  REVERB_HOST=127.0.0.1
  REVERB_PORT=$port
  REVERB_SCHEME=http
  VITE_REVERB_HOST=$name.$TLD
  VITE_REVERB_PORT=443
  VITE_REVERB_SCHEME=https
EOF
}

case "${1:-}" in
    setup)   shift; cmd_setup "$@" ;;
    add)     shift; cmd_add "$@" ;;
    proxy)   shift; cmd_proxy "$@" ;;
    rm)      shift; cmd_rm "$@" ;;
    start)   shift; cmd_start "$@" ;;
    stop)    shift; cmd_stop "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    list|ls) shift; cmd_list "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    info)    shift; cmd_info "$@" ;;
    reload)  shift; reload_proxy; echo "Front proxy reloaded" ;;
    shims)   shift; cmd_shims "$@" ;;
    workers) shift; cmd_workers "$@" ;;
    refresh) shift; cmd_refresh "$@" ;;
    install) shift; cmd_update install "$@" ;;
    update)  shift; cmd_update update "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    service) shift; cmd_service "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 1 ;;
esac
